{
    "name": "opennars-304-ts",
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "bin": {
        "opennars-304": "dist/cli.mjs",
        "opennars-304-shell": "dist/shell.mjs"
    },
    "description": "OpenNARS 3.0.4 的 TypeScript 迁移版（开发中 🚧）。当前主线优先保证 Java canonical 基线与 TypeScript 的功能证据一致，再进入性能与发布门禁。",
    "directories": {
        "doc": "docs",
        "test": "test"
    },
    "scripts": {
        "test": "npm run test:unit:serial",
        "typecheck": "tsc --noEmit --pretty false --incremental false",
        "test:unit": "node --import ./scripts/register-ts-loader.mjs --test --experimental-strip-types test/node/*.test.ts",
        "test:unit:serial": "node --import ./scripts/register-ts-loader.mjs --test --test-concurrency=1 --experimental-strip-types test/node/*.test.ts",
        "test:serial": "npm run test:unit:serial",
        "build": "node scripts/build.mjs",
        "cli:dist": "node --import ./scripts/register-ts-loader.mjs dist/cli.mjs",
        "test:build": "npm run build && node scripts/check-build.mjs",
        "test:api:dist": "node scripts/check-built-api.mjs dist/index.js",
        "test:release": "npm run build && node scripts/check-release-package.mjs",
        "prepack": "npm run build",
        "scan:migration-patterns": "node scripts/converting/scan-migration-patterns.mjs",
        "apply:migration-patterns": "node scripts/converting/apply-migration-patterns.mjs",
        "test:parity:local": "node --import ./scripts/register-ts-loader.mjs scripts/parity/run-local-algorithm-parity.mjs",
        "benchmark:m3": "node scripts/e2e/run-m3-benchmark.mjs",
        "cli": "node --import ./scripts/register-ts-loader.mjs scripts/cli.mjs",
        "shell": "node --import ./scripts/register-ts-loader.mjs scripts/shell.mjs",
        "shell:dist": "node --import ./scripts/register-ts-loader.mjs dist/shell.mjs",
        "test:e2e:java:smoke": "node scripts/e2e/run-nal-corpus.mjs --engine java --limit 5",
        "test:e2e:ts:smoke": "node scripts/e2e/run-nal-corpus.mjs --engine ts --limit 5",
        "test:e2e:java": "node scripts/e2e/run-nal-corpus.mjs --engine java --all",
        "test:e2e:parity": "node scripts/e2e/run-nal-corpus.mjs --engine parity --limit 5",
        "test:e2e:parity:serial": "node scripts/e2e/run-nal-corpus.mjs --engine parity --all --cycles 1550 --timeout-ms 30000 --process-limit-ms 180000 --ts-mode cold --chunk-size 1 --summary",
        "test:e2e:parity:serial:smoke": "node scripts/e2e/run-nal-corpus.mjs --engine parity --limit 5 --cycles 1550 --timeout-ms 30000 --process-limit-ms 180000 --ts-mode cold --chunk-size 1 --summary"
    },
    "author": "",
    "license": "MIT",
    "files": [
        "dist",
        "src",
        "config",
        "scripts/cli.mjs",
        "README.md"
    ],
    "dependencies": {
        "jree": "1.3.0"
    },
    "devDependencies": {
        "@types/node": "^20.12.12",
        "typescript": "^5.4.5"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ARCJ137442/OpenNARS-304-ts.git"
    },
    "keywords": [],
    "bugs": {
        "url": "https://github.com/ARCJ137442/OpenNARS-304-ts/issues"
    },
    "homepage": "https://github.com/ARCJ137442/OpenNARS-304-ts#readme"
}
