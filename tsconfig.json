{
    "compilerOptions": {
        "incremental": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "sourceMap": true,
        "strict": true,
        "noImplicitReturns": true,
        "moduleResolution": "node",
        "allowImportingTsExtensions": true,
        "stripInternal": true,
        "noEmit": true,
        "lib": [
            "esnext",
            "dom"
        ],
        "target": "esnext",
    }
}
